rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function signedInUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      return isSignedIn() && signedInUserRole() in ["admin", "Admin", "ADMIN"];
    }

    function isManager() {
      return isSignedIn() && signedInUserRole() in ["manager", "Manager", "MANAGER"];
    }

    function isAdminOrManager() {
      return isAdmin() || isManager();
    }
    
    // =============================
    // Users
    // =============================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() ||
        (isManager() && resource.data.createdBy == request.auth.uid);
      allow create: if isOwner(userId) ||
        (isAdmin() && request.resource.data.createdBy == request.auth.uid) ||
        (isManager() && request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.role in ["employee", "Employee", "EMPLOYEE"]);
      allow update: if isOwner(userId) || isAdmin() ||
        (isManager() && resource.data.createdBy == request.auth.uid &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.role == resource.data.role);
      allow delete: if isAdmin() ||
        (isManager() && resource.data.createdBy == request.auth.uid);
    }
    
    // =============================
    // Attendance
    // =============================
    match /attendance/{attendanceId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // =============================
    // QR Codes
    // =============================
    match /qr_codes/{qrId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    // =============================
    // Devices
    // =============================
    match /devices/{deviceId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }
    
    // =============================
    // Logs
    // =============================
    match /logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }
    
    // =============================
    // Settings
    // =============================
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
