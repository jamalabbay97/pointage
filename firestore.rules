rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function signedInUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      return isSignedIn() && signedInUserRole() in ["admin", "Admin", "ADMIN"];
    }

    function isManager() {
      return isSignedIn() && signedInUserRole() in ["manager", "Manager", "MANAGER"];
    }

    function isAdminOrManager() {
      return isAdmin() || isManager();
    }

    function attendanceUserId(data) {
      return data.employeeId != null ? data.employeeId : data.userId;
    }

    function isAttendanceOwner(data) {
      return isSignedIn() && attendanceUserId(data) == request.auth.uid;
    }

    // Returns true when a Manager update only touches the allowed location fields.
    // Managers must not change role, status, email, or any other sensitive field.
    function isManagerLocationOnlyUpdate() {
      let allowed = [
        'assignedLocationLat',
        'assignedLocationLng',
        'assignedLocationRadius',
        'locationAssignedBy'
      ];
      // All keys being written must be in the allowed set, AND
      // the role / status / email fields must remain untouched.
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed)
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.email == resource.data.email;
    }
    
    // =============================
    // Users
    // =============================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() ||
        (isManager() && (resource.data.createdBy == request.auth.uid || resource.data.managerId == request.auth.uid));
      allow create: if isOwner(userId) ||
        (isAdmin() && request.resource.data.createdBy == request.auth.uid) ||
        (isManager() && request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.role in ["employee", "Employee", "EMPLOYEE"]);
      allow update: if isAdmin() ||
        isOwner(userId) ||
        (isManager() && (resource.data.createdBy == request.auth.uid || resource.data.managerId == request.auth.uid) &&
          (
            request.resource.data.role == resource.data.role ||
            isManagerLocationOnlyUpdate()
          )
        );
      allow delete: if isAdmin() ||
        (isManager() && (resource.data.createdBy == request.auth.uid || resource.data.managerId == request.auth.uid));
    }
    
    // =============================
    // Attendance
    // =============================
    match /attendance/{attendanceId} {
      allow create: if isSignedIn() &&
        (isAdminOrManager() || isAttendanceOwner(request.resource.data));
      allow read: if isAdminOrManager() || isAttendanceOwner(resource.data);
      allow update: if isAdminOrManager() ||
        (isAttendanceOwner(resource.data) && isAttendanceOwner(request.resource.data));
      allow delete: if isAdmin();
    }
    
    // =============================
    // QR Codes
    // =============================
    match /qr_codes/{qrId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrManager();
    }
    
    // =============================
    // Devices
    // =============================
    match /devices/{deviceId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false;
    }
    
    // =============================
    // Logs
    // =============================
    match /logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
      allow update: if false;
      allow delete: if false;
    }
    
    // =============================
    // Settings
    // =============================
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
