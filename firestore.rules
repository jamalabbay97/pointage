rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function signedInUserRole() {
      // Use get() with a fallback to avoid errors if the user document does not exist yet
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null ? userDoc.data.get('role', '') : '';
    }
    
    function isAdmin() {
      return isSignedIn() && signedInUserRole() in ["admin", "Admin", "ADMIN"];
    }

    function isManager() {
      return isSignedIn() && signedInUserRole() in ["manager", "Manager", "MANAGER"];
    }

    function isAdminOrManager() {
      return isAdmin() || isManager();
    }

    function attendanceUserId(data) {
      return data != null ? data.get('employeeId', data.get('userId', '')) : '';
    }

    function isAttendanceOwner(data) {
      return isSignedIn() && data != null && attendanceUserId(data) == request.auth.uid;
    }


    
    // =============================
    // Users
    // =============================
    // Rules Summary:
    // - A Manager can edit an employee if they are the createdBy or managerId.
    // - A Manager cannot change the employee's role, createdBy, or managerId.
    // - A Manager can delete employees associated with them.
    // - A Manager cannot create an Admin or Manager; creation is restricted to Employees only.
    // - An Employee can modify almost all of their account data, but cannot change their role, createdBy, or managerId.
    // - An Admin can modify/delete all users, even if they did not create them.
    match /users/{userId} {
      // get: single-document read (resource is available for field-level checks).
      // list: collection-level query used by reports — resource is null so field checks don't work;
      //   managers can list all users here but app-layer filtering restricts what they see.
      allow get: if isOwner(userId) || isAdmin() ||
        (isManager() && resource != null && (resource.data.get('createdBy', '') == request.auth.uid || resource.data.get('managerId', '') == request.auth.uid));
      allow list: if isAdmin() || isManager();
      
      allow create: if (isOwner(userId) && request.resource.data.get('role', 'employee').lower() == 'employee') ||
        (isAdmin() && request.resource.data.get('createdBy', '') == request.auth.uid) ||
        (isManager() && request.resource.data.get('createdBy', '') == request.auth.uid &&
          request.resource.data.get('role', '') in ["employee", "Employee", "EMPLOYEE"]);
          
      allow update: if (isOwner(userId) && 
          request.resource.data.get('role', resource.data.get('role', '')) == resource.data.get('role', '') &&
          request.resource.data.get('createdBy', resource.data.get('createdBy', '')) == resource.data.get('createdBy', '') &&
          request.resource.data.get('managerId', resource.data.get('managerId', '')) == resource.data.get('managerId', '') &&
          (!resource.data.keys().hasAll(['boundDeviceId']) || resource.data.get('boundDeviceId', '') == '' || request.resource.data.get('boundDeviceId', '') == resource.data.get('boundDeviceId', '') || request.resource.data.get('isAutoRepair', false) == true) &&
          (!resource.data.keys().hasAll(['activeDeviceIdHash']) || resource.data.get('activeDeviceIdHash', '') == '' || request.resource.data.get('activeDeviceIdHash', '') == resource.data.get('activeDeviceIdHash', '') || request.resource.data.get('isAutoRepair', false) == true) &&
          (!resource.data.keys().hasAll(['deviceBinding']) || resource.data.get('deviceBinding', null) == null || request.resource.data.get('deviceBinding', null) == resource.data.get('deviceBinding', null) || request.resource.data.get('isAutoRepair', false) == true || (request.resource.data.get('activeDeviceIdHash', '') == resource.data.get('activeDeviceIdHash', '') && resource.data.get('activeDeviceIdHash', '') != ''))) || 

        isAdmin() ||
        (isManager() && resource != null && 
          (resource.data.get('createdBy', '') == request.auth.uid || resource.data.get('managerId', '') == request.auth.uid) &&
          request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '') &&
          request.resource.data.get('managerId', '') == resource.data.get('managerId', '') &&
          request.resource.data.get('role', '') == resource.data.get('role', ''));
          
      allow delete: if isAdmin() ||
        (isManager() && resource != null && (resource.data.get('createdBy', '') == request.auth.uid || resource.data.get('managerId', '') == request.auth.uid));
    }
    
    // =============================
    // Attendance
    // =============================
    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        (isAdminOrManager() || isAttendanceOwner(request.resource.data));
      allow update: if isSignedIn() &&
        (isAdminOrManager() || (resource != null && isAttendanceOwner(resource.data)));
      allow delete: if isAdmin();
    }
    
    // =============================
    // QR Codes
    // =============================
    match /qr_codes/{qrId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrManager();
    }
    
    // =============================
    // Devices
    // =============================
    match /devices/{deviceId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false || isAdmin(); // Improved: allowed admins to delete old devices
    }
    
    // =============================
    // Logs
    // =============================
    match /logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
      allow update: if false;
      allow delete: if false || isAdmin(); // Improved: allowed admins to cleanup logs
    }
    
    // =============================
    // User Settings
    // =============================
    match /user_settings/{userId} {
      allow read, write: if isOwner(userId) || isAdmin(); // Improved: admins can configure user settings
    }
    
    // =============================
    // Settings
    // =============================
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =============================
    // Notifications
    // =============================
    match /notifications/{notifId} {
      // Any signed-in user can read; client-side filtering handles visibility.
      allow read: if isSignedIn();

      // Only admin or manager can broadcast notifications; signed-in users can create reminders for themselves.
      allow create: if (isAdminOrManager() && request.resource.data.get('senderId', '') == request.auth.uid) ||
        (isSignedIn() && request.resource.data.get('targetUserId', '') == request.auth.uid);

      // Any signed-in user may update ONLY the readBy and deletedBy fields.
      allow update: if isSignedIn() && resource != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'deletedBy']) &&
        request.resource.data.get('readBy', []).hasAll(resource.data.get('readBy', [])) &&
        request.resource.data.get('deletedBy', []).hasAll(resource.data.get('deletedBy', []));

      // Admin can delete any notification. Manager can delete their own notifications.
      allow delete: if isAdmin() || 
        (isManager() && resource != null && resource.data.get('senderId', '') == request.auth.uid);
    }
  }
}
