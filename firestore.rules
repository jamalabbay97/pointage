rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function signedInUserRole() {
      // Use get() with a fallback to avoid errors if the user document does not exist yet
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc != null ? userDoc.data.get('role', '') : '';
    }
    
    function isAdmin() {
      return isSignedIn() && signedInUserRole() in ["admin", "Admin", "ADMIN"];
    }

    function isManager() {
      return isSignedIn() && signedInUserRole() in ["manager", "Manager", "MANAGER"];
    }

    function isAdminOrManager() {
      return isAdmin() || isManager();
    }

    function attendanceUserId(data) {
      return data != null ? data.get('employeeId', data.get('userId', '')) : '';
    }

    function isAttendanceOwner(data) {
      return isSignedIn() && data != null && attendanceUserId(data) == request.auth.uid;
    }

    // Returns true when a Manager update only touches the allowed location fields.
    // Managers must not change role, status, email, or any other sensitive field.
    function isManagerLocationOnlyUpdate() {
      let allowed = [
        'assignedLocationLat',
        'assignedLocationLng',
        'assignedLocationRadius',
        'locationAssignedBy'
      ];
      // All keys being written must be in the allowed set, AND
      // the role / status / email fields must remain untouched.
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed)
          && request.resource.data.get('role', '') == resource.data.get('role', '')
          && request.resource.data.get('status', '') == resource.data.get('status', '')
          && request.resource.data.get('email', '') == resource.data.get('email', '');
    }
    
    // =============================
    // Users
    // =============================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() ||
        (isManager() && resource != null && (resource.data.get('createdBy', '') == request.auth.uid || resource.data.get('managerId', '') == request.auth.uid));
      
      allow create: if isOwner(userId) ||
        (isAdmin() && request.resource.data.get('createdBy', '') == request.auth.uid) ||
        (isManager() && request.resource.data.get('createdBy', '') == request.auth.uid &&
          request.resource.data.get('role', '') in ["employee", "Employee", "EMPLOYEE"]);
          
      allow update: if isOwner(userId) || isAdmin() ||
        (isManager() && resource != null && 
          (resource.data.get('createdBy', '') == request.auth.uid || resource.data.get('managerId', '') == request.auth.uid) &&
          request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '') &&
          request.resource.data.get('managerId', '') == resource.data.get('managerId', '') &&
          request.resource.data.get('role', '') == resource.data.get('role', ''));
          
      allow delete: if isAdmin() ||
        (isManager() && resource != null && (resource.data.get('createdBy', '') == request.auth.uid || resource.data.get('managerId', '') == request.auth.uid));
    }
    
    // =============================
    // Attendance
    // =============================
    match /attendance/{attendanceId} {
      allow create: if isSignedIn() &&
        (isAdminOrManager() || isAttendanceOwner(request.resource.data));
        
      // Fixed: When checking in for the first time, the document doesn't exist yet so resource is null.
      // We allow the read if the attendanceId matches the user's uid to prevent permission denied errors.
      allow read: if isAdminOrManager() || 
        (resource != null && isAttendanceOwner(resource.data)) ||
        (resource == null && attendanceId.matches(request.auth.uid + '.*'));
        
      allow update: if isAdminOrManager() ||
        (resource != null && isAttendanceOwner(resource.data) && isAttendanceOwner(request.resource.data));
        
      allow delete: if isAdmin();
    }
    
    // =============================
    // QR Codes
    // =============================
    match /qr_codes/{qrId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrManager();
    }
    
    // =============================
    // Devices
    // =============================
    match /devices/{deviceId} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if false || isAdmin(); // Improved: allowed admins to delete old devices
    }
    
    // =============================
    // Logs
    // =============================
    match /logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
      allow update: if false;
      allow delete: if false || isAdmin(); // Improved: allowed admins to cleanup logs
    }
    
    // =============================
    // User Settings
    // =============================
    match /user_settings/{userId} {
      allow read, write: if isOwner(userId) || isAdmin(); // Improved: admins can configure user settings
    }
    
    // =============================
    // Settings
    // =============================
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // =============================
    // Notifications
    // =============================
    match /notifications/{notifId} {
      // Any signed-in user can read; client-side filtering handles visibility.
      allow read: if isSignedIn();

      // Only admin or manager can create a notification.
      allow create: if isAdminOrManager() &&
        request.resource.data.get('senderId', '') == request.auth.uid;

      // Any signed-in user may update ONLY the readBy field (mark as read).
      allow update: if isSignedIn() && resource != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) &&
        request.resource.data.get('readBy', []).hasAll(resource.data.get('readBy', [])) &&
        request.resource.data.get('readBy', []).hasAll([request.auth.uid]);

      // Only admin can delete notifications.
      allow delete: if isAdmin();
    }
  }
}
